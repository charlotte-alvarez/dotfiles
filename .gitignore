# Ignore everything by default
*

# Allow gitignore itself
!.gitignore

# Allow emacs and everything inside
!emacs/
!emacs/**

# Now ignore certain subdirs inside emacs
emacs/elpaca/
emacs/eln-cache/
emacs/projectile-bookmarks.eld
emacs/recentf
emacs/elpa/
emacs/elfeed/
emacs/.local/
emacs/auto-save-list/
emacs/ido.last
emacs/transient/
*~ # Backup files


# Other allowed dirs/files
!nvim/
!nvim/**

!.bashrc
!README.md

# powerline
!powerline/
!powerline/**
!powerline/*

# kitty
!kitty/
!kitty/**
!kitty/*

# bash
!bash/
!bash/**
!bash/*
